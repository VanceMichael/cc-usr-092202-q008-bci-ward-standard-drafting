{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "脑机病房标准编制脱敏试点观察样例",
  "type": "object",
  "required": [
    "domain",
    "version",
    "sample_id",
    "observations"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "const": "bci-ward-standard-drafting"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "note": {
      "type": "string"
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "clause_id",
          "site",
          "period",
          "summary",
          "deidentified"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "clause_id": {
            "type": "string",
            "minLength": 1
          },
          "site": {
            "type": "string",
            "minLength": 1
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "deidentified": {
            "const": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
